# ==============================================================================
# BrollForge Environment Configuration
# ==============================================================================

# Application & Environment
APP_NAME=BrollForge
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Security & Secrets
SECRET_KEY=dev-secret-key-incubrix-brollforge-2026-production-ready
WEBHOOK_SECRET=incubrix-hmac-webhook-secret-key-32chars
API_KEY_RATE_LIMIT=60/minute

# Database Configuration (PostgreSQL with SQLite fallback for local dev/testing)
DATABASE_URL=postgresql://brolluser:brollpass@postgres:5432/brolldb
# For local dev without docker postgres, can be: sqlite:///./storage/brollforge.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis & Queue Configuration
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=broll_render_queue
JOB_TIMEOUT_SECONDS=600

# Storage (MinIO / S3 / Local Fallback)
STORAGE_BACKEND=local
# Options: 's3', 'minio', 'local'
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=brollforge-artifacts
S3_REGION=us-east-1
LOCAL_STORAGE_PATH=./storage

# Media Processing & FFmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
DEFAULT_FRAME_RATE=30
DEFAULT_VIDEO_CODEC=libx264
DEFAULT_AUDIO_CODEC=aac
DEFAULT_PIXEL_FORMAT=yuv420p
MAX_AUDIO_DURATION_SECONDS=600
MIN_SCENE_DURATION_SECONDS=2.0
MAX_SCENE_DURATION_SECONDS=10.0

# Transcription (faster-whisper)
WHISPER_MODEL=base
# Options: tiny, base, small, medium, large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Text-To-Speech (edge-tts)
DEFAULT_TTS_VOICE=en-IN-NeerjaNeural
# Options: en-IN-NeerjaNeural (en-IN-female), en-IN-PrabhatNeural, en-US-AriaNeural, etc.
TTS_PROVIDER=edge-tts

# Footage Providers
FOOTAGE_PRIMARY_PROVIDER=pexels
# PEXELS_API_KEY: optional. If not set, system falls back to secondary / local verified pack / test mock
PEXELS_API_KEY=
FOOTAGE_SECONDARY_PROVIDER=local_pack
LOCAL_FOOTAGE_PATH=./storage/licensed_footage_pack

# Semantic Matching & Embeddings
EMBEDDING_PROVIDER=tfidf_semantic
# Options: 'tfidf_semantic' (deterministic fast offline), 'sentence_transformers'
REUSE_PENALTY_FACTOR=0.75

# Output Defaults
DEFAULT_ASPECT_RATIOS=["16:9","9:16","1:1"]
DEFAULT_STYLE=bright, modern, real-world footage
DEFAULT_AVOID=["people's faces","alcohol","violence","logos"]
DEFAULT_BURN_CAPTIONS=true
DEFAULT_GENERATE_SRT=true
